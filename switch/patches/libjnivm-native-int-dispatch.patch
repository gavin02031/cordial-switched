+// The embedded VM has no general foreign-function marshaller yet. Supply only
+// the one verified integer ABI; an unsupported registration must fail rather
+// than leave a method that silently returns zero when Java calls it.
+class RegisteredIntNative final : public jnivm::MethodHandle {
+	void *callback;
+public:
+	explicit RegisteredIntNative(void *fn) : callback(fn) {}
+	jint StaticInvoke(ENV *runtime, Class *clazz, const jvalue *args,
+	                  jnivm::impl::MethodHandleBase<jint>) override {
+		auto owner = std::static_pointer_cast<Class>(clazz->shared_from_this());
+		jclass ref = JNITypes<std::shared_ptr<Class>>::ToJNIType(runtime, owner);
+		if (!ref) throw std::runtime_error("Cannot reference registered native class");
+		jint value = reinterpret_cast<jint (*)(JNIEnv *, jclass, jint)>(callback)(
+		    runtime->GetJNIEnv(), ref, args[0].i);
+		runtime->GetJNIEnv()->DeleteLocalRef(ref);
+		return value;
 	}
-	return 0;
+	jint InstanceInvoke(ENV *runtime, jobject object, const jvalue *args,
+	                    jnivm::impl::MethodHandleBase<jint>) override {
+		return reinterpret_cast<jint (*)(JNIEnv *, jobject, jint)>(callback)(
+		    runtime->GetJNIEnv(), object, args[0].i);
+	}
+};
+
+jint RegisterNatives(JNIEnv *env, jclass c, const JNINativeMethod *methods, jint count) {
+	auto clazz = JNITypes<std::shared_ptr<jnivm::Class>>::JNICast(ENV::FromJNIEnv(env), c);
+	if (!clazz || count < 0 || (count && !methods)) return JNI_ERR;
+	std::lock_guard<std::mutex> lock(clazz->mtx);
+	std::vector<std::shared_ptr<Method>> targets;
+	for (jint n = 0; n < count; ++n) {
+		const JNINativeMethod &candidate = methods[n];
+		if (!candidate.name || !candidate.signature || !candidate.fnPtr ||
+		    std::string(candidate.signature) != "(I)I") return JNI_ERR;
+		auto it = std::find_if(clazz->methods.begin(), clazz->methods.end(),
+		    [&candidate](const std::shared_ptr<Method> &declared) {
+		        return !declared->native && declared->name == candidate.name &&
+		               declared->signature == candidate.signature;
+		    });
+		if (it == clazz->methods.end()) return JNI_ERR;
+		targets.push_back(*it);
+	}
+	for (jint n = 0; n < count; ++n) {
+		targets[n]->native = methods[n].fnPtr;
+		targets[n]->nativehandle = std::make_shared<RegisteredIntNative>(methods[n].fnPtr);
+		clazz->natives[methods[n].name] = methods[n].fnPtr;
+	}
+	return JNI_OK;
 };
